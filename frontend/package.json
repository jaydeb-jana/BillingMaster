    "vaul": "^1.1.2",
    "vite": "^7.3.2",
    "wait-on": "^9.1.0",
    "wouter": "^3.3.5",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}

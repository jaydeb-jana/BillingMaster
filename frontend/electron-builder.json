{
  "appId": "com.billingmaster.desktop",
  "productName": "BillingMaster",
  "copyright": "Copyright © 2026 BillingMaster",
  "directories": {
    "output": "release"
  },
  "asar": true,
  "files": [
    "dist/public/**/*",
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "BillingMaster"
  }
}
